# SampleForge configuration.
#
# Every field is read with the SAMPLEFORGE_ prefix (app/core/config.py). Copy to
# .env and edit: `cp .env.example .env`. Docker Compose reads this file directly
# via env_file, so the same values serve the host and the containers.

# --- Service ---------------------------------------------------------------
SAMPLEFORGE_VERSION=0.1.0
SAMPLEFORGE_ENVIRONMENT=development

# --- Auth ------------------------------------------------------------------
# JSON list: the value pydantic-settings parses for a list[str] field. An empty
# list leaves the API unconfigured, and every authenticated endpoint then answers
# 503 rather than serving unauthenticated traffic.
SAMPLEFORGE_API_KEYS=["dev-key-change-me"]
SAMPLEFORGE_API_KEY_HEADER=X-API-Key

# --- Rate limiting ---------------------------------------------------------
SAMPLEFORGE_RATE_LIMIT_ENABLED=true
SAMPLEFORGE_GENERATE_RATE_LIMIT=100/minute
SAMPLEFORGE_BATCH_RATE_LIMIT=10/minute

# --- Database --------------------------------------------------------------
# Host runs: localhost. Inside compose the hostname is the service name, so the
# API and worker services override this to postgres.
SAMPLEFORGE_DATABASE_URL=postgresql+asyncpg://sampleforge:sampleforge@localhost:5432/sampleforge
SAMPLEFORGE_DB_POOL_SIZE=5
SAMPLEFORGE_DB_MAX_OVERFLOW=5

# --- Queue -----------------------------------------------------------------
SAMPLEFORGE_REDIS_URL=redis://localhost:6379/0

# --- Storage ---------------------------------------------------------------
# local writes under SAMPLEFORGE_LOCAL_STORAGE_DIR; s3 uploads to the bucket
# below using the standard AWS_* credential variables (boto3's default chain).
SAMPLEFORGE_STORAGE_BACKEND=local
SAMPLEFORGE_LOCAL_STORAGE_DIR=./var/samples

# MinIO, for the s3 backend in development.
# SAMPLEFORGE_STORAGE_BACKEND=s3
# SAMPLEFORGE_S3_BUCKET=sampleforge
# SAMPLEFORGE_S3_PREFIX=samples
# SAMPLEFORGE_S3_ENDPOINT_URL=http://localhost:9000
# SAMPLEFORGE_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=sampleforge
# AWS_SECRET_ACCESS_KEY=sampleforge-secret

# --- Generation ------------------------------------------------------------
# Path to the generator checkpoint. Unset means "no local weights", which the
# worker reports as a model-load failure per job rather than at boot.
# SAMPLEFORGE_MODEL_PATH=/models/sampleforge-vae
# cuda on a GPU host, cpu everywhere else. `make dev` runs the worker on CPU by
# default; switch this to cuda when you have uncommented the GPU block in
# docker-compose.yml.
SAMPLEFORGE_DEVICE=cpu
SAMPLEFORGE_MAX_BATCH_SIZE=64

# --- Retry policy ----------------------------------------------------------
SAMPLEFORGE_JOB_MAX_ATTEMPTS=3
SAMPLEFORGE_RETRY_BASE_DELAY_SECONDS=0.5
SAMPLEFORGE_RETRY_MAX_DELAY_SECONDS=30
